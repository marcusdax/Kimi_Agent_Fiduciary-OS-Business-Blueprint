# Server Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database (Prisma schema currently targets SQLite; PostgreSQL is the production target)
DATABASE_URL=file:./dev.db

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Auth0 Configuration (not used by the current code)
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_AUDIENCE=your-auth0-api-identifier
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Security
BCRYPT_ROUNDS=12

# External APIs (all optional; endpoints fall back to canned/mock data without them)
ANTHROPIC_API_KEY=
KIMI_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Not wired to any carrier today; insurance quotes are illustrative
INSURANCE_API_KEY=

# Feature Flags
ENABLE_AI_INSIGHTS=true
ENABLE_REALTIME_UPDATES=true
ENABLE_CRYPTO_MODULE=true
