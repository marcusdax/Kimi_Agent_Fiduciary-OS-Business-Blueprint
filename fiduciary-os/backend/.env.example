# Server Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database (Prisma schema currently targets SQLite; PostgreSQL is the production target)
DATABASE_URL=file:./dev.db

# Redis (optional; set false to disable without retry noise)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Auth0 Configuration (not used by the current code)
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_AUDIENCE=your-auth0-api-identifier
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Security
BCRYPT_ROUNDS=12

# External APIs (optional in development).
# Without a key, endpoints return labelled placeholder data ("source": "mock" or "fallback").
# With NODE_ENV=production, placeholders are refused and the endpoint returns 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-5
ALPHA_VANTAGE_API_KEY=
# Insurance figures are always illustrative: there is no carrier or quoting-partner integration.

# Feature Flags
ENABLE_AI_INSIGHTS=true

# MASTERNEX.os (Phase 1 — optional; env-gated, safe to leave unset in dev)
MASTERNEX_API_URL=http://localhost:8080
MASTERNEX_JWT=

# trust-core sidecar (Phase 1 — optional; enables tamper-evident AI audit ledger)
TRUST_CORE_URL=http://localhost:3002
# Generate TRUST_CORE_SERVICE_TOKEN with: npm run generate-service-token
# Requires TRUST_CORE_JWT_SECRET — generate secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TRUST_CORE_JWT_SECRET=
TRUST_CORE_SERVICE_TOKEN=

# Supabase (Phase 2 — replace SQLite with Supabase/PostgreSQL)
# Prisma uses two URLs: DATABASE_URL for queries (pooler), DIRECT_URL for migrations.
#
# Supavisor session-mode pooler (port 5432) — runtime queries
# DATABASE_URL=postgresql://postgres.[project-ref]:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# Direct connection (port 5432) — prisma db push / migrate deploy only
# DIRECT_URL=postgresql://postgres:[DB-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Simulated price stream for UI development; never runs in production
ENABLE_REALTIME_UPDATES=false
ENABLE_CRYPTO_MODULE=true

# K-Dense Kady (Phase 3 — Advisor Command Center MCP registration)
# When KDENSE_URL is set, the backend registers trust-core and MASTERNEX as global
# MCP servers in K-Dense on startup via PUT /mcp?scope=global.
# Leave blank in dev if K-Dense is not running locally.
KDENSE_URL=
KDENSE_AUTH_TOKEN=
# MCP URLs used for the registration payload (defaults shown — override for Docker)
# TRUST_CORE_MCP_URL=http://127.0.0.1:3001/mcp
# MASTERNEX_MCP_URL=http://127.0.0.1:8080/mcp

# HuggingFace (Phase 4 — Document Intelligence Pipeline)
# HF_TOKEN enables live LayoutLM/BART-MNLI document classification and
# ProsusAI/finbert financial sentiment scoring. Leave blank for deterministic fallback.
HF_TOKEN=
# Optional model overrides (defaults shown):
# HF_DOC_CLASSIFICATION_MODEL=facebook/bart-large-mnli
# HF_SENTIMENT_MODEL=ProsusAI/finbert
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Google Drive vault folder ID for encrypted document storage anchor
GOOGLE_DRIVE_VAULT_FOLDER_ID=
