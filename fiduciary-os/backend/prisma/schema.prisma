generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String
  role          String    @default("client")
  advisorCode   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? @map("deleted_at")

  profile           Profile?
  portfolio         Portfolio?
  documents         Document[]
  sessions          Session[]
  aiInteractions    AiInteraction[]
  planningActions   PlanningAction[]
  financialPlan     FinancialPlan?
  toolScenarios     ToolScenario[]
  authSessions      AuthSession[]
  ownedHouseholds   Household[]     @relation("HouseholdOwner")
  advisedHouseholds Household[]     @relation("HouseholdAdvisor")
  personProfile     Person?
  consentRecords    ConsentRecord[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  age               Int      @default(45)
  retirementAge     Int      @default(65)
  filingStatus      String   @default("married")
  stateTaxRate      Int      @default(0)
  employmentStatus  String   @default("employed")
  annualIncome      Int      @default(150000)
  investableAssets  Int      @default(500000)
  monthlyExpenses   Int      @default(6000)
  retirementSavings Int      @default(300000)
  primaryGoal       String   @default("retire")
  riskTolerance     Int      @default(3)
  investmentStyle   String   @default("active")
  cryptoAllocation  Int      @default(5)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Portfolio {
  id         String    @id @default(uuid())
  userId     String    @unique
  totalValue Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings   Holding[]

  @@map("portfolios")
}

model Holding {
  id          String   @id @default(uuid())
  portfolioId String
  symbol      String
  quantity    Float
  avgCost     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
  @@map("holdings")
}

model Document {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String
  size        Int
  path        String
  encrypted   Boolean  @default(true)
  uploadedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// Supervisory record of every AI prompt and response (see services/aiGateway.ts).
// Kept when a user is deleted (userId set to null) so the review trail survives.
model AiInteraction {
  id            String   @id @default(uuid())
  userId        String?
  endpoint      String
  provider      String
  model         String?
  source        String
  policyVersion String
  prompt        String
  response      String
  blocked       Boolean  @default(false)
  flags         String[] @default([])
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_interactions")
}

// Owner-scoped planning coordination only. No financial transaction execution.
model PlanningAction {
  id                 String          @id @default(uuid())
  userId             String
  title              String
  outcome            String
  owner              String
  source             String
  assumptions        String
  alternatives       String
  costs              String
  stage              String          @default("Gather information")
  version            Int             @default(1)
  authorizedVersion  Int?
  reviewDate         String?
  completionEvidence String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  events             PlanningEvent[]

  @@index([userId, createdAt])
  @@map("planning_actions")
}

// Append-only through the API; not an attested tamper-proof records system.
model PlanningEvent {
  id        String         @id @default(uuid())
  actionId  String
  actorId   String
  type      String
  version   Int
  details   String
  createdAt DateTime       @default(now())
  action    PlanningAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, version])
  @@map("planning_events")
}

// One owner-scoped, versioned manual-input plan. No market prices or execution.
model FinancialPlan {
  id        String   @id @default(uuid())
  userId    String   @unique
  inputs    String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_plans")
}

model ToolScenario {
  methodVersion String?
  resultSnapshot String?
  id String @id @default(cuid())
  userId String
  kind String
  inputs String
  version Int @default(1)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, kind])
}

model AuthSession {
  id String @id
  userId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens SessionRefresh[]
  @@index([userId])
}
model SessionRefresh {
  digest String @id
  sessionId String
  expiresAt DateTime
  usedAt DateTime?
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
}

// Vector embeddings for semantic search over planning actions, AI interactions, and documents.
// Requires pgvector extension (enable in supabase/setup.sql).
model Embedding {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  vector     Unsupported("vector(1536)")
  model      String
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
  @@map("embedding")
}

// Durable ledger entries mirrored from trust-core for SQL queries and backup.
// The authoritative source is always trust-core; this is a queryable replica.
model LedgerEntry {
  seq         Int      @id
  id          String   @unique
  at          DateTime
  action      String
  actor       String
  subject     String
  anchors     Json     @default("{}")
  payloadHash String?
  supersedes  String?
  prevHash    String
  hash        String   @unique

  @@index([subject, at])
  @@map("ledger_entries")
}

// Durable workspace records for Will & Trust Atelier, Proposed Symphony, and White-Label Tenant settings.
model WorkspaceState {
  scopeKey  String   @id
  category  String
  label     String
  payload   Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category, updatedAt])
  @@map("workspace_states")
}

// ============================================================================
// Household Graph CRM, Consent Ledger & WORM Provenance (PostgreSQL + pgcrypto)
// ============================================================================

model Household {
  id               String    @id @default(uuid())
  name             String
  lifecycleStage   String    @default("PROSPECT") @map("lifecycle_stage")
  ownerUserId      String?   @map("owner_user_id")
  primaryAdvisorId String?   @map("primary_advisor_id")
  metadata         Json?
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  owner          User?           @relation("HouseholdOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  primaryAdvisor User?           @relation("HouseholdAdvisor", fields: [primaryAdvisorId], references: [id], onDelete: SetNull)
  people         Person[]
  crmAccounts    CrmAccount[]
  appointments   Appointment[]
  lifeEvents     LifeEvent[]
  consentRecords ConsentRecord[]

  @@index([ownerUserId])
  @@index([primaryAdvisorId])
  @@index([lifecycleStage])
  @@map("households")
}

model Person {
  id                    String    @id @default(uuid())
  householdId           String    @map("household_id")
  userId                String?   @unique @map("user_id")
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  email                 String?
  phone                 String?
  dateOfBirth           DateTime? @map("date_of_birth")
  ssnEncrypted          Bytes?    @map("ssn_encrypted")
  ssnLast4              String?   @map("ssn_last4")
  role                  String    @default("PLANNER_PARENT")
  relationshipToPrimary String?   @map("relationship_to_primary")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  crmAccounts CrmAccount[]
  lifeEvents  LifeEvent[]

  @@index([householdId])
  @@map("people")
}

model CrmAccount {
  id                        String    @id @default(uuid())
  householdId               String    @map("household_id")
  personId                  String?   @map("person_id")
  institutionName           String    @map("institution_name")
  accountName               String?   @map("account_name")
  accountType               String    @map("account_type")
  balance                   Decimal   @default(0) @db.Decimal(18, 2)
  source                    String    @default("MANUAL")
  lastSyncedAt              DateTime? @map("last_synced_at")
  isActive                  Boolean   @default(true) @map("is_active")
  plaidItemId               String?   @map("plaid_item_id")
  plaidAccessTokenEncrypted Bytes?    @map("plaid_access_token_encrypted")
  plaidCursor               String?   @map("plaid_cursor")
  deletedAt                 DateTime? @map("deleted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([personId])
  @@map("crm_accounts")
}

model Appointment {
  id              String   @id @default(uuid())
  householdId     String   @map("household_id")
  advisorId       String?  @map("advisor_id")
  title           String
  scheduledAt     DateTime @map("scheduled_at")
  durationMinutes Int      @default(30) @map("duration_minutes")
  status          String   @default("SCHEDULED")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, scheduledAt])
  @@map("appointments")
}

model LifeEvent {
  id            String   @id @default(uuid())
  householdId   String   @map("household_id")
  personId      String?  @map("person_id")
  eventType     String   @map("event_type")
  eventDate     DateTime @map("event_date")
  impactSummary String?  @map("impact_summary")
  status        String   @default("PLANNED")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([householdId, eventDate])
  @@map("life_events")
}

model ConsentRecord {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  householdId         String?  @map("household_id")
  channel             String
  status              String
  doubleOptInVerified Boolean  @default(false) @map("double_opt_in_verified")
  source              String
  ipAddress           String?  @map("ip_address")
  proofHash           String   @map("proof_hash")
  recordedAt          DateTime @default(now()) @map("recorded_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([userId, channel, recordedAt])
  @@map("consent_records")
}

// Append-only, hash-chained WORM provenance log (enforced by PostgreSQL triggers).
// Deliberately has NO FK to users so user lifecycle/test cleanup never triggers DELETE on this table.
model ProvenanceRecord {
  id         String   @id @default(uuid())
  sequence   Int      @unique @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at")
  actorId    String   @map("actor_id")
  recordType String   @map("record_type")
  prevHash   String   @map("prev_hash")
  rowHash    String   @unique @map("row_hash")
  payload    Json     @default("{}")

  @@index([actorId, occurredAt])
  @@index([recordType, occurredAt])
  @@map("provenance_records")
}

