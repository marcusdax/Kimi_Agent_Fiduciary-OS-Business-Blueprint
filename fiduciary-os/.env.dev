# ── Fiduciary OS — committed dev defaults (non-sensitive) ─────────────────────
# Override anything here by creating fiduciary-os/.env (gitignored).
# Generate fresh secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# SQLite — zero-config local database
DATABASE_URL=file:./dev.db

# Auth
JWT_SECRET=dev-jwt-secret-replace-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS — Vite dev server
CORS_ORIGIN=http://localhost:5173

# Redis — disabled in dev
REDIS_ENABLED=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev

# Security
BCRYPT_ROUNDS=10

# Feature flags
ENABLE_AI_INSIGHTS=true
ENABLE_REALTIME_UPDATES=false
ENABLE_CRYPTO_MODULE=true

# trust-core sidecar — Docker hostname
TRUST_CORE_URL=http://trust-core:3002
# Generate a real secret for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TRUST_CORE_JWT_SECRET=dev-trust-core-secret-replace-in-production
TRUST_CORE_SERVICE_TOKEN=

# MASTERNEX — optional; leave blank if not running
MASTERNEX_API_URL=http://masternex:8080
MASTERNEX_JWT=

# AI providers — optional; endpoints return mock data without keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-5
ALPHA_VANTAGE_API_KEY=

# Supabase — optional; SQLite is used without these
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# K-Dense — optional
KDENSE_URL=
KDENSE_AUTH_TOKEN=

# HuggingFace — optional
HF_TOKEN=
