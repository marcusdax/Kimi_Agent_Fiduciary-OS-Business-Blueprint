{
  "name": "@fiduciary-os/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/export-preview.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"src/*.{ts,tsx}\" vite.config.ts tsconfig.json index.html scripts/*.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
